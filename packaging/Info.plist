<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MotionArcade</string>
    <key>CFBundleDisplayName</key>
    <string>体感游戏厅</string>
    <key>CFBundleExecutable</key>
    <string>MotionArcade</string>
    <key>CFBundleIdentifier</key>
    <string>cn.sichuan.motionarcade</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>

    <!-- 摄像头权限说明：不写这条，系统不会弹授权窗，而是直接静默拒绝 -->
    <key>NSCameraUsageDescription</key>
    <string>体感游戏厅需要使用摄像头来识别你的头部与手部动作，从而控制游戏。画面只在本地实时处理，不会被保存或上传。</string>

    <!-- 高分屏：让 App 以物理像素渲染，而不是被放大成 2 倍模糊 -->
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>

    <!-- 以独立应用而非后台进程身份运行，保证能创建窗口 -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.games</string>
    <key>LSBackgroundOnly</key>
    <false/>
    <key>LSUIElement</key>
    <false/>
</dict>
</plist>
